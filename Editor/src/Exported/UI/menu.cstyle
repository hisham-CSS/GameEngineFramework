/*
  Main menu styling. Structure is in menu.cxml; this file is the whole look.

  HOT RELOAD: the running app reads the STAGED copy next to the executable
  (build/bin/<config>/Exported/UI/), which every build refreshes from this file.
  Save that copy while the editor or player is running and the change appears
  within a quarter of a second — no rebuild, no restart. Copy it back here to
  keep it.

  TWO RULES THIS FILE OBEYS, both of which cost real time to rediscover:

  1. `position: absolute` writes ALL FOUR insets. Style::Edges defaults every
     side to 0 rather than to "unset", and UIElement pushes all four to yoga
     unconditionally, so left/top always win over a right/bottom you wrote
     alone. Absolute appears twice here and both write all four as zero.

  2. `gap` is a NUMBER, not a Length: `gap: 10` is right and `gap: 10px` is a
     parse error. Same for flex-grow, flex-shrink and the four insets. The
     parser reports the RULE's line rather than the declaration's, so look at
     every declaration in the block it names.

  3. `font-scale` multiplies the BAKED ATLAS SIZE, which is 48px
     (kUIFontAtlasPixels in Font.h). So 0.375 is 18px and 1.0 is 48px. Nothing
     inherits, so the `*` rule below is what makes "ordinary text" ordinary —
     without it every unstyled label renders at full atlas size.
*/

* {
  font-scale: 0.375;              /* 18px against the 48px atlas */
}

#menu {
  width: 100%;
  height: 100%;
  color: rgba(232, 236, 244, 1);
}

/* ------------------------------------------------------------ backdrop -- */

/* `cover` crops to fill instead of distorting, which is what a photographic
   backdrop needs the moment the window stops being 16:9. Both layers are
   click-through, or they would swallow every press meant for the card. */
.backdrop {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image: "Exported/UI/art/menu_backdrop.png";
  background-size: cover;
  pointer-events: none;
}

.veil {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-color: rgba(8, 10, 16, 0.72);
  pointer-events: none;
}

/* ---------------------------------------------------------- the layout -- */

.frame {
  width: 100%;
  height: 100%;
  flex-direction: row;
  align-items: center;
  padding: 48px 56px;
  gap: 48;
}

.brand {
  width: 300px;
  flex-direction: column;
  align-items: flex-start;
  gap: 10;
}

.logo {
  width: 128px;
  height: 128px;
  background-image: "Exported/UI/art/logo.png";
  background-size: stretch;      /* square art in a square box: nothing to crop */
  margin: 0 0 6px 0;
}

/* 0.83 * 48 = 40px, and the atlas is 48 — so this magnifies by nothing. That
   is the entire reason the font is baked at 48 rather than at body size. */
.brand-title {
  font-scale: 0.83;
  color: rgba(255, 255, 255, 1);
}

.brand-sub {
  font-scale: 0.33;
  color: rgba(255, 196, 72, 1);
}

.brand-rule {
  width: 72px;
  height: 3px;
  background-color: rgba(255, 196, 72, 1);
  border-radius: 2px;
  margin: 8px 0 14px 0;
}

.field-label {
  font-scale: 0.29;
  color: rgba(150, 160, 178, 1);
}

.field {
  width: 100%;
  padding: 9px 12px;
  background-color: rgba(0, 0, 0, 0.45);
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.14);
  border-radius: 8px;
  color: rgba(232, 236, 244, 1);
}

.field:focus {
  border-color: rgba(255, 196, 72, 0.9);
  background-color: rgba(0, 0, 0, 0.6);
}

/* ------------------------------------------------------------- the card - */

/* NO background-image here, on purpose. A background-image is a SEPARATE quad
   drawn OVER the background colour (not a tint of it), so an opaque panel
   texture would throw away this card's translucency -- and panel.png is 64x64
   flat navy, which at a 10x stretch adds nothing but softness. A solid fill
   plus a radius and a hairline border is both crisper and genuinely see-through
   over the backdrop.

   `fill.a *= outer` in the box shader clips the fill to the BORDER box, which
   is what stops a translucent card showing the scene through its own rounded
   corners. background-image is still demonstrated twice, on .backdrop (cover)
   and .logo (stretch) -- both background-size values. */
.card {
  flex-grow: 1;
  height: 100%;
  max-width: 720px;
  flex-direction: column;
  background-color: rgba(18, 21, 30, 0.88);
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.1);
  border-radius: 18px;
  padding: 8px;
}

/* ------------------------------------------------------------ tab strip - */

/* A <Tab> produces TWO elements: the header (styled by `.tab`, engine-supplied)
   and the panel (which takes everything else the Tab carried). Selection is a
   plain CLASS on the header, so `.tab.selected` is the whole styling story. */
.tab {
  padding: 10px 20px;
  margin: 0 4px 0 0;
  color: rgba(150, 160, 178, 1);
  background-color: rgba(255, 255, 255, 0.03);
  border-radius: 10px;
  border-width: 1px;
  border-color: rgba(0, 0, 0, 0);
  font-scale: 0.33;
}

.tab:hover {
  color: rgba(232, 236, 244, 1);
  background-color: rgba(255, 255, 255, 0.08);
}

.tab.selected {
  color: rgba(16, 18, 24, 1);
  background-color: rgba(255, 196, 72, 1);
  border-color: rgba(255, 216, 130, 1);
}

.tab:focus {
  border-color: rgba(255, 196, 72, 0.8);
}

/* The panel a <Tab> becomes. */
.page {
  flex-direction: column;
  padding: 22px 20px 12px 20px;
  gap: 10;
}

.page-title {
  font-scale: 0.35;
  color: rgba(255, 196, 72, 1);
  margin: 6px 0 2px 0;
}

.page-note {
  font-scale: 0.27;
  color: rgba(138, 148, 166, 1);
}

.spacer {
  height: 8px;
}

/* --------------------------------------------------------------- rows --- */

.row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.row-left {
  flex-direction: row;
  align-items: center;
  gap: 8;
}

.row-label {
  font-scale: 0.31;
  color: rgba(196, 204, 218, 1);
}

.row-value {
  font-scale: 0.31;
  color: rgba(255, 196, 72, 1);
}

/* ------------------------------------------------------------- buttons -- */

.btn {
  padding: 11px 18px;
  background-color: rgba(255, 255, 255, 0.06);
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.14);
  border-radius: 10px;
  color: rgba(232, 236, 244, 1);
  font-scale: 0.33;
}

.btn:hover {
  background-color: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.28);
}

.btn:active {
  background-color: rgba(255, 196, 72, 0.28);
  border-color: rgba(255, 196, 72, 0.7);
}

.btn:focus {
  border-color: rgba(255, 196, 72, 0.85);
}

.btn-primary {
  background-color: rgba(255, 196, 72, 1);
  border-color: rgba(255, 216, 130, 1);
  color: rgba(16, 18, 24, 1);
  padding: 15px 22px;
  font-scale: 0.4;
  margin: 4px 0 0 0;
}

.btn-primary:hover {
  background-color: rgba(255, 210, 110, 1);
}

.btn-primary:active {
  background-color: rgba(226, 168, 48, 1);
}

.btn-step {
  padding: 8px 16px;
  font-scale: 0.31;
}

.btn-chip {
  padding: 7px 14px;
  font-scale: 0.29;
  color: rgba(160, 170, 188, 1);
}

/* Toggled by `classes=` from a bool the C++ side publishes. */
.chip-on {
  background-color: rgba(255, 196, 72, 0.9);
  border-color: rgba(255, 216, 130, 1);
  color: rgba(16, 18, 24, 1);
}

/* --------------------------------------------------------------- meter -- */

.meter {
  width: 100%;
  height: 10px;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 5px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.08);
}

/* `width` is BOUND in the markup, so the value here is only the pre-bind
   default — the loader says so at startup rather than letting the two
   disagree silently. */
.meter-fill {
  width: 50%;
  height: 100%;
  background-color: rgba(255, 196, 72, 1);
  border-radius: 5px;
}

/* --------------------------------------------------------- the counters - */

.stats {
  flex-direction: row;
  gap: 10;
  width: 100%;
}

.stat {
  flex-grow: 1;
  flex-direction: column;
  align-items: center;
  padding: 12px 6px;
  background-color: rgba(0, 0, 0, 0.35);
  border-radius: 12px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.08);
}

.stat-num {
  font-scale: 0.58;
  color: rgba(255, 255, 255, 1);
}

.stat-cap {
  font-scale: 0.25;
  color: rgba(138, 148, 166, 1);
}

/* ------------------------------------------------------------ swap log -- */

.log {
  width: 100%;
  flex-direction: column;
  gap: 3;
  padding: 8px;
  background-color: rgba(0, 0, 0, 0.35);
  border-radius: 10px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.07);
}

.log-row {
  flex-direction: row;
  align-items: center;
  gap: 10;
  padding: 5px 8px;
  border-radius: 6px;
  background-color: rgba(255, 255, 255, 0.03);
}

.log-idx {
  width: 28px;
  font-scale: 0.25;
  color: rgba(120, 130, 148, 1);
}

.log-path {
  flex-grow: 1;
  font-scale: 0.27;
  color: rgba(214, 220, 232, 1);
}

.log-status {
  font-scale: 0.25;
  color: rgba(120, 200, 140, 1);
}

.log-bad {
  color: rgba(240, 110, 100, 1);
}

/* -------------------------------------------------------------- status -- */

.status {
  width: 100%;
  padding: 10px 20px;
  border-radius: 10px;
  background-color: rgba(0, 0, 0, 0.3);
  margin: 4px 0 0 0;
}

.status-text {
  font-scale: 0.27;
  color: rgba(150, 200, 165, 1);
}

.status-bad {
  color: rgba(240, 130, 110, 1);
}
