/*
  Main menu styling — cinematic. Structure is in menu.cxml; this is the look.

  HOT RELOAD: the running app reads the STAGED copy next to the executable
  (build/bin/<config>/Exported/UI/), which every build refreshes from this file.
  Save that copy while the editor or player is running and the change appears
  within a quarter of a second. Copy it back here to keep it.

  THREE RULES THIS FILE OBEYS, each of which costs real time to rediscover:

  1. `position: absolute` writes ALL FOUR insets. Style::Edges defaults every
     side to 0 rather than to "unset", and UIElement pushes all four to yoga
     unconditionally, so left/top always win over a right/bottom written alone.
     Absolute appears three times here and all three write all four as zero.

  2. `gap`, `flex-grow`, `flex-shrink` and the four insets are NUMBERS and
     reject a unit: `gap: 10` is right, `gap: 10px` is a parse error that kills
     the whole sheet. width / height / border-radius / border-width are Lengths
     and require one. The parser reports the RULE's line rather than the
     declaration's, so read every line in the block it names.

  3. `font-scale` multiplies the BAKED ATLAS SIZE, 48px (kUIFontAtlasPixels in
     Font.h). So 0.375 is 18px and 1.0 is 48px. Nothing inherits, which is why
     the `*` rule below exists at all.

  THE VISUAL IDEA: the art is the hero and the UI is type over it. No button
  fills, no borders on the verbs, no radii. The only shape in the whole menu is
  a gold rule. A verb's state is a COLOUR and a marker, which is also the only
  kind of motion this engine can express cheaply — colour is one of two
  properties on the binder's non-layout fast path.
*/

* {
  font-scale: 0.375;
}

#menu {
  width: 100%;
  height: 100%;
  color: rgba(232, 236, 244, 1);
}

/* ------------------------------------------------------- the three layers - */

.backdrop {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image: "Exported/UI/art/menu_backdrop.png";
  background-size: cover;
  pointer-events: none;
}

/* A contrast FLOOR, so the menu stays legible over art nobody has seen yet. */
.veil {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-color: rgba(8, 10, 16, 0.55);
  pointer-events: none;
}

/* ...and a directional ramp on top of it: dark under the type on the left,
   clear on the right where the art should show. There is no gradient PROPERTY,
   but a stretched linear ramp is still a linear ramp, and stretching a 256px
   gradient across the screen is the one case bilinear filtering handles
   perfectly. */
.ramp {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image: "Exported/UI/art/scrim_ramp.png";
  background-size: stretch;
  pointer-events: none;
}

/* ------------------------------------------------------------- the frame -- */

.frame {
  width: 100%;
  height: 100%;
  flex-direction: row;
  align-items: center;
  padding: 56px 72px;
}

/* ------------------------------------------------------- the verb column -- */

.verbs {
  width: 460px;
  flex-direction: column;
  align-items: flex-start;
  gap: 2;
}

.logo {
  width: 96px;
  height: 96px;
  background-image: "Exported/UI/art/logo.png";
  background-size: stretch;
  margin: 0 0 14px 0;
}

/* 0.83 * 48 = 40px against a 48px atlas: no magnification at all, which is the
   entire reason the font is baked large. */
.brand-title {
  font-scale: 0.83;
  color: rgba(255, 255, 255, 1);
}

.brand-sub {
  font-scale: 0.3;
  color: rgba(255, 196, 72, 1);
  margin: 2px 0 0 0;
}

.rule {
  width: 84px;
  height: 3px;
  background-color: rgba(255, 196, 72, 1);
  margin: 22px 0 18px 0;
}

.rule-thin {
  width: 220px;
  height: 1px;
  background-color: rgba(255, 255, 255, 0.12);
  margin: 22px 0 12px 0;
}

/* A VERB is type. No fill, no border, no radius — the padding is a hit target,
   not a shape. */
.verb {
  padding: 9px 0;
  background-color: rgba(0, 0, 0, 0);
  border-width: 0px;
  font-scale: 0.71;                     /* 34px */
  color: rgba(176, 184, 200, 1);
}

.verb:hover {
  color: rgba(255, 255, 255, 1);
}

/* FOCUS is the important state here, not hover: this menu is meant to be
   driven by a pad, where hover does not exist. Left padding opens up to make
   room for the marker below, so the focused verb visibly steps forward. */
.verb:focus {
  color: rgba(255, 196, 72, 1);
  padding: 9px 0 9px 22px;
}

/* The marker. A left border rather than a separate element: one property, no
   extra box, and it cannot fall out of step with the focus state. */
.verb:focus {
  border-width: 3px;
  border-color: rgba(255, 196, 72, 1);
}

.verb:active {
  color: rgba(255, 224, 150, 1);
}

.verb-small {
  padding: 8px 0;
  background-color: rgba(0, 0, 0, 0);
  border-width: 0px;
  font-scale: 0.36;
  color: rgba(160, 170, 188, 1);
}

.verb-small:hover { color: rgba(255, 255, 255, 1); }
.verb-small:focus {
  color: rgba(255, 196, 72, 1);
  border-width: 2px;
  border-color: rgba(255, 196, 72, 1);
  padding: 8px 0 8px 14px;
}

.hint {
  font-scale: 0.27;
  color: rgba(138, 148, 166, 1);
}

.hint-bad {
  color: rgba(240, 130, 110, 1);
}

/* ------------------------------------------------------------ the panels -- */

/* A panel REPLACES the verb column rather than sitting beside it, which is what
   makes the stack legible: one thing has navigation at a time. */
.panel {
  width: 620px;
  flex-direction: column;
  align-items: flex-start;
  gap: 6;
}

.panel-head {
  flex-direction: row;
  /* NOT `baseline` -- the supported values are auto|flex-start|center|flex-end|
     stretch, and the loader reports anything else rather than ignoring it.
     flex-end lines the small hint up with the bottom of the title, which is
     what baseline was reaching for. */
  align-items: flex-end;
  justify-content: space-between;
  width: 100%;
  margin: 0 0 6px 0;
}

.panel-title {
  font-scale: 0.71;
  color: rgba(255, 255, 255, 1);
}

.panel-hint {
  font-scale: 0.27;
  color: rgba(138, 148, 166, 1);
}

.panel-note {
  font-scale: 0.25;
  color: rgba(128, 138, 156, 1);
  margin: 2px 0 8px 0;
}

.panel-foot {
  margin: 18px 0 0 0;
}

.group {
  font-scale: 0.29;
  color: rgba(255, 196, 72, 1);
  margin: 16px 0 4px 0;
}

.opt {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 4px 0;
}

.opt-label {
  font-scale: 0.33;
  color: rgba(210, 217, 230, 1);
}

.opt-value {
  font-scale: 0.33;
  color: rgba(255, 196, 72, 1);
}

/* --------------------------------------------------------------- controls - */

.slider {
  width: 100%;
  height: 16px;
  background-color: rgba(255, 255, 255, 0.08);
  border-radius: 8px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.06);
  padding: 0;
  margin: 2px 0 0 0;
}

.slider:hover { border-color: rgba(255, 255, 255, 0.2); }

/* Focusable BY TYPE, like a field — so it needs a visible focus state or a Tab
   stop reads as a dropped keystroke. */
.slider:focus {
  border-color: rgba(255, 196, 72, 1);
  border-width: 2px;
}

.slider-fill {
  height: 100%;
  background-color: rgba(255, 196, 72, 1);
  border-radius: 8px;
  pointer-events: none;
}

.chips {
  flex-direction: row;
  align-items: center;
  gap: 8;
  margin: 4px 0 0 0;
}

.chip {
  padding: 8px 16px;
  background-color: rgba(255, 255, 255, 0.05);
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.1);
  border-radius: 4px;
  font-scale: 0.29;
  color: rgba(168, 178, 196, 1);
}

.chip:hover {
  background-color: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 1);
}

.chip:focus {
  border-color: rgba(255, 196, 72, 1);
  color: rgba(255, 255, 255, 1);
}

/* Toggled by `classes=` from a bool the C++ side publishes. */
.chip-on {
  background-color: rgba(255, 196, 72, 0.92);
  border-color: rgba(255, 216, 130, 1);
  color: rgba(16, 18, 24, 1);
}

.field {
  width: 100%;
  padding: 10px 12px;
  background-color: rgba(0, 0, 0, 0.4);
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.12);
  border-radius: 4px;
  color: rgba(232, 236, 244, 1);
  margin: 2px 0 0 0;
}

.field:focus {
  border-color: rgba(255, 196, 72, 1);
  background-color: rgba(0, 0, 0, 0.55);
}

/* ------------------------------------------------------------- the stats -- */

.stats {
  flex-direction: row;
  gap: 10;
  width: 100%;
  margin: 4px 0 0 0;
}

.stat {
  flex-grow: 1;
  flex-direction: column;
  align-items: center;
  padding: 14px 6px;
  background-color: rgba(255, 255, 255, 0.04);
  border-radius: 4px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.07);
}

.stat-num {
  font-scale: 0.58;
  color: rgba(255, 255, 255, 1);
}

.stat-cap {
  font-scale: 0.23;
  color: rgba(138, 148, 166, 1);
}

/* ----------------------------------------------------------- the swap log - */

.log {
  width: 100%;
  flex-direction: column;
  gap: 3;
  padding: 8px;
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 4px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.06);
}

.log-row {
  flex-direction: row;
  align-items: center;
  gap: 10;
  padding: 5px 8px;
  border-radius: 3px;
  background-color: rgba(255, 255, 255, 0.03);
}

.log-idx {
  width: 28px;
  font-scale: 0.25;
  color: rgba(120, 130, 148, 1);
}

.log-path {
  flex-grow: 1;
  font-scale: 0.27;
  color: rgba(214, 220, 232, 1);
}

.log-status {
  font-scale: 0.25;
  color: rgba(150, 200, 165, 1);
}
