/*
  Main menu styling. Structure is in menu.cxml; this file is the whole look.

  HOT RELOAD: the running app reads the STAGED copy next to the executable
  (build/bin/<config>/Exported/UI/), which every build refreshes from this file.
  Save that copy while the editor or player is running and the change appears
  within a quarter of a second. Copy it back here to keep it.

  FOUR RULES THIS FILE OBEYS, each of which costs real time to rediscover:

  1. `position: absolute` writes ALL FOUR insets. Style::Edges defaults every
     side to 0 rather than "unset", and UIElement pushes all four to yoga
     unconditionally, so left/top always win over a right/bottom written alone.

  2. `gap`, `flex-grow`, `flex-shrink` and the four insets are NUMBERS and
     reject a unit: `gap: 10` is right, `gap: 10px` is a parse error that kills
     the WHOLE sheet and leaves the previous one running. width / height /
     border-radius / border-width are Lengths and require one. The parser
     reports the RULE's line, not the declaration's, so read every line in the
     block it names.

  3. `font-scale` multiplies the BAKED ATLAS SIZE, 48px (kUIFontAtlasPixels in
     Font.h). So 0.375 is 18px and 1.0 is 48px. Nothing inherits, which is why
     the `*` rule exists — and why its value is a real step of the scale below
     rather than an arbitrary default.

  4. `border-width` is ONE uniform float and it is PAINT ONLY: there is no
     border-left-width, and a border does not inset the content box, so a child
     will happily paint over it.

  THE TYPE SCALE — five steps, and nothing between them. The previous version
  had eleven sizes buying about three legible tiers, eight of them inside a 7px
  band with four adjacent pairs under a pixel apart.

     0.71   34px   verbs
     0.58   28px   wordmark, stat numbers
     0.46   22px   EVERYTHING YOU OPERATE — labels, values, chips, the field
     0.375  18px   log rows, the status line, and the `*` default
     0.27   13px   captions, keycaps, the log index

  That fourth step is 0.375 rather than a rounder number because it IS
  kUIFontBodyPixels / kUIFontAtlasPixels — the size the atlas was baked to
  serve. Text at exactly that scale is resampled 1:1. A test asserts it.

  THE PALETTE — twelve values. The previous version had thirty-five, including
  nine opaque greys forming a continuous ramp in 8-unit steps and nine white
  alphas from 0.03 to 0.20, six of which sat within 12% luminance of the page.
  That is why cards read as outlines around nothing.
*/

* {
  font-scale: 0.375;
}

#menu {
  width: 100%;
  height: 100%;
}

/* ------------------------------------------------------- the three layers - */

.backdrop {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image: "Exported/UI/art/menu_backdrop.png";
  background-size: cover;
  pointer-events: none;
}

.veil {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-color: rgba(8, 10, 16, 0.55);
  pointer-events: none;
}

.ramp {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image: "Exported/UI/art/scrim_ramp.png";
  background-size: stretch;
  pointer-events: none;
}

/* ------------------------------------------------------------- the frame -- */

.frame {
  width: 100%;
  height: 100%;
  flex-direction: column;
  padding: 44px 64px;
}

/* ------------------------------------------------------------ the header -- */

.header {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.brand {
  flex-direction: row;
  align-items: center;
  gap: 16;
}

/* The drama comes from the MARK, not from the type. font-scale is multiplied by
   surfaceWidth/1280 before it reaches the 48px atlas, so a wordmark at 0.83
   renders at 1.25x the atlas at 1080p and gets softer on every wider monitor —
   the studio's name was the blurriest object on screen. Art is crisp at any
   scale, so the logo grew and the wordmark came down a step. */
.logo {
  width: 72px;
  height: 72px;
  background-image: "Exported/UI/art/logo.png";
  background-size: stretch;
}

.brand-text {
  flex-direction: column;
}

.brand-title {
  font-scale: 0.58;
  color: rgba(255, 255, 255, 1);
}

.brand-sub {
  font-scale: 0.27;
  color: rgba(255, 196, 72, 1);
  margin: 3px 0 0 0;
}

.crumb-text {
  font-scale: 0.375;
  color: rgba(132, 142, 162, 1);
}

/* ------------------------------------------------------------- the stage -- */

/* Takes the slack, so the header stays at the top and the footer at the bottom
   whatever is between them. Without this, opening a taller panel moved the
   whole composition. */
.stage {
  width: 100%;
  flex-grow: 1;
  flex-direction: column;
  justify-content: center;
}

/* -------------------------------------------------------------- the verbs - */

.verbs {
  width: 320px;
  flex-direction: column;
  align-items: flex-start;
  gap: 6;
}

.rule {
  width: 72px;
  height: 3px;
  background-color: rgba(255, 196, 72, 1);
  margin: 0 0 20px 0;
}

/* A verb is type on a BAND. Full width, because a button sizes to its text and
   any highlight drawn on one hugs the glyphs — which is what made the first
   version look like a badly-fitted box. 320px rather than 460: at 460 the
   loudest object on screen was 60-78% empty.
   Padding is constant across every state, so moving focus does not reflow. */
.verb {
  width: 100%;
  /* A verb is one line by definition. Text wraps by default now, and a longer
     word in a 320px column would silently become a two-line button whose
     neighbours all shift down. */
  white-space: nowrap;
  padding: 11px 16px;
  border-radius: 3px;
  font-scale: 0.71;
  color: rgba(198, 206, 222, 1);
}

.verb:hover {
  color: rgba(255, 255, 255, 1);
  background-color: rgba(255, 255, 255, 0.10);
}

/* FOCUS, not hover, is the state that matters here: this menu is driven by a
   pad, where hover does not exist.
   The band is a two-stop gradient fading out to the right — a directional
   highlight rather than a flat slab, and it costs nothing: vColor is already
   interpolated across the quad, so two corner colours IS the gradient. */
.verb:focus {
  color: rgba(255, 226, 158, 1);
  background-color: rgba(255, 196, 72, 0.28);
  background-color-to: rgba(255, 196, 72, 0.04);
  background-gradient: horizontal;
}

.verb:active {
  color: rgba(16, 18, 24, 1);
  background-color: rgba(255, 226, 158, 1);
  background-color-to: rgba(255, 196, 72, 1);
  background-gradient: horizontal;
}

/* A GAME MODE's verb. The four verbs above are four words somebody typed into
   menu.cxml; a mode's label is DATA — it is whatever title this build ships
   calling itself whatever it likes, and this menu ships with the engine, so it
   has to survive a name nobody here has seen. Both properties are about that
   and neither is decoration:

     font-scale   0.71 puts ~34px glyphs in a 288px content box, which fits
                  about 17 characters. "Untitled Fighting Game" is 22 and would
                  have run straight out of the 320px band while the focus
                  highlight — width: 100% — stayed 320 wide. 0.50 is ~24px, so
                  a name of about 24 characters fits on one line.
     white-space  .verb sets nowrap so that a long word cannot silently make a
                  two-line button and shift its neighbours down. That reasoning
                  is about text typed HERE, where a surprise is a bug. A mode's
                  name can be any length at all, and an overlong one wrapping to
                  two lines is much better than one drawn outside its own
                  highlight. Deliberate here, surprising there.

   Later in the file than .verb on purpose: the cascade is CSS specificity with
   later-wins on ties, and these two rules tie. */
.verb-mode {
  font-scale: 0.50;
  white-space: normal;
}

/* QUIT is the one verb you cannot undo. It should not look like NEW GAME. */
.verb-danger {
  margin: 14px 0 0 0;
}

.verb-danger:focus {
  color: rgba(255, 214, 200, 1);
  background-color: rgba(240, 130, 110, 0.30);
  background-color-to: rgba(240, 130, 110, 0.04);
  background-gradient: horizontal;
}

.verb-danger:active {
  color: rgba(16, 18, 24, 1);
  background-color: rgba(240, 130, 110, 1);
  background-color-to: rgba(240, 130, 110, 1);
}

/* ------------------------------------------------------------ the panels -- */

.panel {
  width: 720px;
  flex-direction: column;
  align-items: flex-start;
  gap: 4;
}

/* ONE ROW SHAPE. Same height, same label column, every setting.
   min-height centres CHILDREN, which is what makes this work here and would
   NOT work on a button: draw_ places an element's own glyphs at
   position + padding.top, so anything carrying text is sized by its padding. */
.opt {
  width: 100%;
  min-height: 52px;
  flex-direction: row;
  align-items: center;
  gap: 16;
}

.opt-label {
  width: 190px;
  font-scale: 0.46;
  color: rgba(198, 206, 222, 1);
}

.opt-value {
  width: 68px;
  font-scale: 0.46;
  color: rgba(255, 196, 72, 1);
}

/* --------------------------------------------------------------- controls - */

.slider {
  flex-grow: 1;
  height: 14px;
  background-color: rgba(255, 255, 255, 0.10);
  border-radius: 7px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.16);
}

.slider:hover  { border-color: rgba(255, 255, 255, 0.16); }
.slider:focus  { border-color: rgba(255, 196, 72, 1); border-width: 2px; }

/* Vertical two-stop, so the fill has a lit top edge and reads as a solid rather
   than a flat block of colour. */
.slider-fill {
  height: 100%;
  background-color: rgba(255, 226, 158, 1);
  background-color-to: rgba(255, 196, 72, 1);
  background-gradient: vertical;
  border-radius: 7px;
  pointer-events: none;
}

/* THE FILL is the focus cue, not the ring: border-width is paint-only and does
   not inset the content box, so at 100% the fill covers the ring entirely and a
   focused slider would be pixel-identical to an unfocused one. */
.slider:focus .slider-fill {
  background-color: rgba(255, 255, 255, 1);
  background-color-to: rgba(255, 226, 158, 1);
}

.chips {
  flex-direction: row;
  align-items: center;
  gap: 8;
}

.chip {
  padding: 9px 16px;
  background-color: rgba(255, 255, 255, 0.10);
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.16);
  border-radius: 4px;
  font-scale: 0.46;
  color: rgba(198, 206, 222, 1);
}

.chip:hover {
  background-color: rgba(255, 255, 255, 0.10);
  color: rgba(255, 255, 255, 1);
}

.chip:focus {
  border-color: rgba(255, 196, 72, 1);
  background-color: rgba(255, 196, 72, 0.28);
  color: rgba(255, 255, 255, 1);
}

.chip:active {
  background-color: rgba(255, 226, 158, 1);
  color: rgba(16, 18, 24, 1);
}

/* SELECTED. `.chip.chip-on` rather than `.chip-on`, and it MUST sit below
   `.chip:focus`: a pseudo-class counts as a class, so `.chip:focus` is (0,2,0)
   and a bare `.chip-on` is (0,1,0) — focus won every one of these and the
   current tier went blank the instant a pad navigated onto it. Two classes ties
   the specificity and file order breaks the tie. */
.chip.chip-on {
  background-color: rgba(255, 196, 72, 1);
  background-color-to: rgba(226, 168, 48, 1);
  background-gradient: vertical;
  border-color: rgba(255, 226, 158, 1);
  color: rgba(16, 18, 24, 1);
}

/* ...and (0,3,0) for focused-AND-selected, which the tie above cannot express:
   without it a focused ON chip would be identical to an unfocused one, so the
   focus ring would disappear instead of the fill. */
.chip.chip-on:focus,
.chip.chip-on:hover {
  border-color: rgba(255, 255, 255, 1);
  border-width: 2px;
}

.field {
  flex-grow: 1;
  padding: 10px 14px;
  background-color: rgba(0, 0, 0, 0.4);
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.16);
  border-radius: 4px;
  font-scale: 0.46;
  color: rgba(255, 255, 255, 1);
}

.field:focus {
  border-color: rgba(255, 196, 72, 1);
  border-width: 2px;
}

/* ------------------------------------------------------------- the stats -- */

.stats {
  width: 100%;
  flex-direction: row;
  gap: 10;
  margin: 0 0 14px 0;
}

/* A visible surface rather than a hairline around nothing: the old border sat
   at 1.09:1 against the page, which is a rounding error, not a border. */
.stat {
  flex-grow: 1;
  flex-direction: column;
  align-items: center;
  padding: 16px 6px;
  background-color: rgba(255, 255, 255, 0.10);
  background-color-to: rgba(255, 255, 255, 0.03);
  background-gradient: vertical;
  border-radius: 4px;
}

.stat-num {
  font-scale: 0.58;
  color: rgba(255, 255, 255, 1);
}

.stat-cap {
  font-scale: 0.27;
  color: rgba(132, 142, 162, 1);
  margin: 4px 0 0 0;
}

/* ----------------------------------------------------------- the swap log - */

/* ONE surface, not two. The old version nested a 0.03 row inside a 0.3 page,
   which composited to within 2/255 of each other — two shapes that cancelled. */
.log {
  width: 100%;
  flex-direction: column;
  padding: 6px 8px;
  background-color: rgba(255, 255, 255, 0.10);
  border-radius: 4px;
  margin: 0 0 14px 0;
}

.log-row {
  width: 100%;
  flex-direction: row;
  align-items: center;
  gap: 12;
  padding: 5px 6px;
}

.log-idx {
  width: 26px;
  font-scale: 0.27;
  color: rgba(132, 142, 162, 1);
}

.log-path {
  flex-grow: 1;
  font-scale: 0.375;
  color: rgba(198, 206, 222, 1);
}

/* NEUTRAL by default, RED when the row says something went wrong.
   It was unconditionally green once, so "invalid", "refused", "load failed"
   and "superseded" all rendered as successes — a status colour that lies is
   worse than none. Colouring per row needs a bool binding in the row template,
   which was a document error for every ABSENT slot until the binder learned to
   skip them. */
.log-status {
  font-scale: 0.27;
  color: rgba(132, 142, 162, 1);
}

.log-bad {
  color: rgba(240, 130, 110, 1);
}

/* ------------------------------------------------------------ the footer -- */

.footer {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.status {
  font-scale: 0.375;
  color: rgba(132, 142, 162, 1);
}

.status-bad {
  color: rgba(240, 130, 110, 1);
}

.legend {
  flex-direction: row;
  align-items: center;
  gap: 18;
}

.key {
  flex-direction: row;
  align-items: center;
  gap: 8;
}

/* NO FIXED WIDTH. The cap holds a BOUND glyph name that changes with the
   player's hands -- "A" on a pad, "ENTER" on a keyboard, "L STICK" vs "WASD" --
   and a 24px circle sized for a single letter cut "ENTER" in half. It sizes to
   its text and keeps a pill radius large enough to round whatever lands in it.
   min-width keeps the one-letter case from collapsing to a sliver. */
.keycap {
  min-width: 26px;
  /* "L STICK" has a space in it, so it is one squeeze away from becoming two
     lines inside a 24px-tall pill. A prompt is a label, not a paragraph. */
  white-space: nowrap;
  padding: 5px 9px;
  background-color: rgba(255, 255, 255, 0.10);
  border-radius: 12px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.16);
  font-scale: 0.27;
  color: rgba(255, 255, 255, 1);
}

.keyname {
  font-scale: 0.27;
  color: rgba(132, 142, 162, 1);
}
