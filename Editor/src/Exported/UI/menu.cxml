<!--
  Main menu — cinematic, and navigable with a controller.

  Nothing installs this: Exported/menu.json has an entity carrying a
  UIDocumentComponent that points here. The verbs behind the buttons are named
  C++ functions registered by InstallMenuUIContent (Engine/src/ui/MenuUIContent.h)
  — a file cannot carry a function, and that is the ONLY thing it cannot carry.

  THE NAVIGATION MODEL, which is the whole reason this file was rewritten.

  A menu is a STACK, not a flat page. Before focus scopes existed, opening a
  panel merely ADDED its controls to one document-wide ring: walking off the end
  of SETTINGS wandered back up to NEW GAME, which is not what any menu anywhere
  does. Now:

    focus-scope="true"   confines navigation to that subtree while it is VISIBLE.
    on-back="..."        is what B / Escape invoke while that scope is the
                         innermost open one.

  Visibility is the single source of truth. A panel is shown by `if=` reading an
  app bool; the scope stack follows DISPLAY, so "open" and "where navigation
  goes" cannot drift apart. Opening remembers what was focused and moves focus
  into the panel; closing puts it back exactly where it was — so SETTINGS
  returns you to the SETTINGS verb, never to the top of the list.

  TWO LAYOUT RULES WORTH KNOWING.
    `position: absolute` writes all four insets unconditionally and Edges
    defaults every side to 0, so a lone `right:` does not right-align anything.
    Absolute is used three times here and all three write all four as zero.
    `gap`, `flex-grow` and the insets are NUMBERS and reject a px unit; width,
    height, border-radius and border-width are Lengths and require one.

  ART is placeholder and committed, so this renders on a fresh clone with no
  asset pipeline: tools/gen_ui_placeholder_art.py regenerates it.
-->
<UI name="menu" data-source="scene">

  <Element name="backdrop" class="backdrop"/>
  <!-- Two scrims rather than one. The flat veil guarantees a contrast floor
       over ARBITRARY art; the ramp is a stretched linear gradient asset, which
       is how you get a gradient with no gradient property. -->
  <Element name="veil" class="veil"/>
  <Element name="ramp" class="ramp"/>

  <Element name="frame" class="frame">

    <!-- ================================================ the verb column == -->
    <!-- The root scope. It is a scope too, so that closing a panel returns
         navigation HERE rather than to the document at large. `if=` hides it
         while a panel is open: a pad user must not be able to cycle through
         NEW GAME behind an open settings page. -->
    <Element name="verbs" class="verbs" focus-scope="true"
             if="!panelOpen">
      <Element name="logo" class="logo"/>
      <Label name="title" class="brand-title" text="CAT SPLAT"/>
      <Label name="subtitle" class="brand-sub" text="ENGINE DEMO"/>
      <Element class="rule"/>

      <!-- No fills, no borders, no radii. The only shape in the menu is the
           gold rule; a verb is TYPE, and its focus state is a colour and a
           marker. That is the whole visual idea. -->
      <Button name="newGame" class="verb" text="NEW GAME" on-click="menuNewGame"/>
      <Button name="settings" class="verb" text="SETTINGS" on-click="menuOpenSettings"/>
      <Button name="system"   class="verb" text="SYSTEM"   on-click="menuOpenSystem"/>
      <Button name="quit"     class="verb" text="QUIT"     on-click="menuQuit"/>

      <Element class="rule-thin"/>
      <Label class="hint" text="{menuStatus}" classes="hint-bad: {menuStatusOk | not}"/>
    </Element>

    <!-- ==================================================== the panels === -->
    <!-- Each is its own scope. Only one is open at a time, but nothing here
         depends on that: nest two and the stack nests with them. -->

    <Element name="settingsPanel" class="panel" focus-scope="true"
             if="panelSettings" on-back="menuClosePanel">
      <Element class="panel-head">
        <Label class="panel-title" text="SETTINGS"/>
        <Label class="panel-hint" text="B / ESC to go back"/>
      </Element>

      <Label class="group" text="AUDIO"/>
      <Element class="opt">
        <Label class="opt-label" text="MASTER VOLUME"/>
        <Label class="opt-value" text="{menuVolumePct}%"/>
      </Element>
      <!-- Press anywhere to jump, then drag; the drag is a pointer CAPTURE so
           it keeps tracking past either end of the track. Focused, the arrows
           and a gamepad stick both nudge it — the pad and the keyboard end up
           in the same UISliderState, so they cannot disagree. -->
      <Slider name="volume" class="slider" bind-value="menuVolume"
              min="0" max="1" key-step="0.05">
        <Element name="volumeFill" class="slider-fill"
                 bind="width: {menuVolume | percent}"/>
      </Slider>

      <Label class="group" text="GRAPHICS"/>
      <Element class="opt">
        <Label class="opt-label" text="QUALITY"/>
        <Label class="opt-value" text="{menuQualityName}"/>
      </Element>
      <Element class="chips">
        <Button class="chip" classes="chip-on: {menuQLow}"
                text="LOW" on-click="menuQualityLow"/>
        <Button class="chip" classes="chip-on: {menuQMed}"
                text="MEDIUM" on-click="menuQualityMedium"/>
        <Button class="chip" classes="chip-on: {menuQHigh}"
                text="HIGH" on-click="menuQualityHigh"/>
      </Element>

      <Element class="opt">
        <Label class="opt-label" text="VSYNC"/>
        <Button class="chip" classes="chip-on: {menuVSync}"
                text="{menuVSyncName}" on-click="menuVSyncToggle"/>
      </Element>

      <Label class="group" text="PILOT"/>
      <TextField name="pilot" class="field" bind-value="playerName" maxlength="24"/>

      <Element class="panel-foot">
        <Button name="settingsBack" class="verb-small" text="BACK"
                on-click="menuClosePanel"/>
      </Element>
    </Element>

    <Element name="systemPanel" class="panel" focus-scope="true"
             if="panelSystem" on-back="menuClosePanel">
      <Element class="panel-head">
        <Label class="panel-title" text="SYSTEM"/>
        <Label class="panel-hint" text="B / ESC to go back"/>
      </Element>

      <!-- Pushed once a frame by MenuUIPublishCounters, never polled: a polled
           property on this source would defeat the binder's version fast path
           for every binding in every document in the process. -->
      <Element class="stats">
        <Element class="stat">
          <Label class="stat-num" text="{menuSwaps}"/>
          <Label class="stat-cap" text="SWAPS"/>
        </Element>
        <Element class="stat">
          <Label class="stat-num" text="{menuLiveDocs}"/>
          <Label class="stat-cap" text="DOCS"/>
        </Element>
        <Element class="stat">
          <Label class="stat-num" text="{menuObservers}"/>
          <Label class="stat-cap" text="OBSERVERS"/>
        </Element>
        <Element class="stat">
          <Label class="stat-num" text="{menuTextures}"/>
          <Label class="stat-cap" text="TEXTURES"/>
        </Element>
      </Element>
      <Label class="panel-note"
             text="OBSERVERS must not move as you swap scenes. Three per swap means the Install helpers are being re-run."/>

      <Label class="group" text="SWAP LOG"/>
      <!-- A fixed pool: four slots built once at load, and the DATA slides
           through them. No class toggle in the row template — a pool writes an
           EMPTY value into every column of an ABSENT slot, and a bool binding
           handed nothing is a document error. -->
      <Element name="swapLog" class="log" repeat="swapLog" repeat-count="4"
               repeat-offset="swapLogCursor">
        <Element class="log-row">
          <Label class="log-idx" text="{$index}"/>
          <Label class="log-path" text="{path}"/>
          <Label class="log-status" text="{status}"/>
        </Element>
      </Element>
      <Element class="chips">
        <Button class="chip" text="PREV" on-click="menuLogPrev"/>
        <Button class="chip" text="NEXT" on-click="menuLogNext"/>
        <Button class="chip" text="CLEAR" on-click="menuLogClear"/>
      </Element>

      <Element class="panel-foot">
        <Button name="systemBack" class="verb-small" text="BACK"
                on-click="menuClosePanel"/>
      </Element>
    </Element>

  </Element>
</UI>
