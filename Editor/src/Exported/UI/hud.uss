/*
  Sample HUD styling.

  HOT RELOAD: the running app reads the STAGED copy next to the executable
  (build/bin/<config>/Exported/UI/), which every build refreshes from this file.
  Save that copy while the editor or player is running and the change appears
  within a quarter of a second — no rebuild, no restart.

  Supported subset (see UIStyleSheet.h): type / .class / #name selectors and
  compounds, the :hover / :active / :focus / :disabled pseudo-classes, descendant
  / child / sibling combinators, CSS specificity, flex properties, lengths as
  auto|px|%, edge shorthands, colours as #hex / rgb() / rgba() / names, position
  + inset, display, overflow (visible|hidden|scroll), pointer-events. Anything
  else is reported as an error rather than silently ignored — check the console
  if a rule seems to do nothing.
*/

#hud {
  flex-direction: column;
  padding: 16px;
}

/* Pushes the health bar and the score readout to opposite ends at ANY width,
   with no arithmetic on the viewport size. */
.row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.row-left {
  flex-direction: row;
  margin: 12px 0px 0px 0px;
}

/* Styled by CLASS, found by NAME: the stylesheet describes a kind of thing, and
   the name is the handle C++ uses to reach one particular instance. */
.track {
  width: 220px;
  height: 18px;
  padding: 3px;
  background-color: rgba(0, 0, 0, 0.45);
}

/* The fill is a percentage of its track, so "set health" is one write to the
   data source and flexbox does the rest.

   width and background-color are BOUND in hud.uxml. The cascade runs BEFORE the
   binding pass on every load, so what is written here is the PRE-BIND DEFAULT:
   what the bar looks like for the instant before the first value arrives, and
   what it falls back to if the binding cannot resolve. Editing these two will
   appear to do nothing at runtime, and the console says so at load:

     [UI] note: the stylesheet declares 'width' for <Element name='healthFill'>,
     which Exported/UI/hud.uxml binds - the stylesheet value is only the
     pre-bind default

   Restyle the TRACK, or edit the binding, for a change that sticks. */
.fill {
  width: 100%;
  height: 100%;
  background-color: #d93a3d;
}

.readout {
  color: rgba(255, 255, 255, 0.95);
}

/* Toggled by `classes="alarm: {lowHealth}"` in hud.uxml. Nothing in C++ knows
   this colour — gameplay sets a bool and the stylesheet decides what it means. */
.alarm {
  color: #ff6b6b;
}

/* A sibling combinator: the row that FOLLOWS the top bar. `+` is the element
   immediately after, `~` is any later one. */
.row + .row-left {
  margin: 12px 0px 0px 0px;
}

/* Interaction styling lives HERE now, not in C++. `:hover` and `:active` count
   as a class for specificity, exactly as in CSS, so both of these outrank the
   plain `.btn` rule with no ordering tricks — and `.btn:active` beats
   `.btn:hover` on source order, which is right because you are always hovering
   while you press.

   Try it: change the pressed colour and save while the game is running. */
.btn {
  padding: 8px 14px;
  background-color: #292d33;
  color: white;
}

.btn:hover {
  background-color: #424852;
}

.btn:active {
  background-color: #d98c26;
  color: #14161a;
}

/* A text field. `:focus` is the state that matters here — a caret with no
   other cue is easy to miss, so the field also changes colour while it owns
   the keyboard. Tab to it and watch both change together. */
.field {
  width: 180px;
  padding: 8px 10px;
  margin: 0px 0px 0px 10px;
  background-color: #1b1e23;
  color: rgba(255, 255, 255, 0.9);
}

.field:hover {
  background-color: #23272e;
}

.field:focus {
  background-color: #2b3138;
  color: white;
}

/* The multi-line field. Its HEIGHT is the whole story: a field scrolls its own
   text to follow the caret but draws no bar and does not grow, so this box is
   what you can see at once. Everything the single-line `.field` does applies
   here too — only Enter, Up and Down change meaning, and that is decided in the
   markup, not here. */
.notes {
  width: 320px;
  height: 84px;
  padding: 8px 10px;
  margin: 10px 0px 0px 0px;
  background-color: #1b1e23;
  color: rgba(255, 255, 255, 0.9);
}

.notes:focus {
  background-color: #2b3138;
  color: white;
}

/* A scrolling panel. `overflow: scroll` clips and scrolls; `hidden` clips only.
   The HEIGHT is what makes it a scroller: `scroll` stops the children being
   squeezed to fit — that is what leaves something to scroll — so a scroller
   without a definite height grows to its content and escapes its parent.

   `overflow` is per axis: `overflow-x` and `overflow-y` set one each and
   `overflow` is the shorthand for both. Source order decides, as in CSS, so
   `overflow: hidden; overflow-y: scroll` clips across and scrolls down. One
   rule inherited from CSS is worth knowing: if you set ONE axis to something
   other than `visible`, the other is promoted too — clipping is a rectangle, so
   an element clips on both axes or neither.

   The scrollbar is an OVERLAY: it reserves no gutter, so it paints over the
   right-hand edge of the content. Add padding-right if that matters; a bar that
   changed the layout could make itself disappear, and back again.

   The bar is styleable — `scrollbar-width`, `scrollbar-min-thumb`,
   `scrollbar-color`, `scrollbar-thumb-color`, and `scrollbar-visibility:
   auto|always` for a bar that shows even when the content currently fits.
   Nothing in this system inherits, so to restyle every bar at once use the
   universal selector: `* { scrollbar-width: 10px; }`. `scrollbar-width: 0`
   hides the bar while leaving the panel scrollable. */
.log {
  overflow: scroll;
  height: 120px;
  width: 320px;
  padding: 6px 10px;
  margin: 4px 0px 0px 0px;
  background-color: rgba(0, 0, 0, 0.35);
  scrollbar-width: 6px;
  scrollbar-thumb-color: rgba(255, 204, 68, 0.5);
}

.log-header {
  color: rgba(255, 255, 255, 0.55);
  font-scale: 0.85;
  margin: 12px 0px 0px 0px;
}

/* An explicit height per row. Nothing here needs it — a Label measures itself —
   but a fixed row is what makes the panel's scroll extent predictable while you
   are editing this file live. */
.entry {
  height: 22px;
  color: rgba(255, 255, 255, 0.85);
}

/* The log is a Tab stop (focusable="true" in hud.uxml), so it needs a visible
   focus cue — there is no outline property, so background-color does the job,
   exactly as .field:focus and .notes:focus already do. */
.log:focus {
  background-color: rgba(0, 0, 0, 0.55);
}

/* A ROW scroller. `overflow-x: scroll` with `overflow-y: hidden` scrolls
   sideways only; note that flex-shrink is overridden on the MAIN axis, which
   for a row is x — that is what stops the slots being squeezed to fit. */
.hotbar {
  flex-direction: row;
  overflow-x: scroll;
  overflow-y: hidden;
  width: 320px;
  height: 44px;
  margin: 10px 0px 0px 0px;
  background-color: rgba(0, 0, 0, 0.35);
  scrollbar-width: 4px;
}

.slot {
  width: 40px;
  height: 32px;
  margin: 4px;
  background-color: rgba(255, 255, 255, 0.12);
}

/* Full-screen, centred by flexbox rather than by computing the middle. */
/* An absolutely positioned child of a SCROLLER is pinned to the scroller's box
   rather than scrolling with its content — a deliberate divergence from CSS,
   because there is no position:fixed or sticky here to offer instead. That is
   what makes a sticky header or a lock veil possible: an inset:0 overlay that
   scrolled away would stop covering AND stop blocking clicks. This one is a
   child of the root, so it simply covers the HUD. */
.centre-overlay {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  justify-content: center;
  align-items: center;
  pointer-events: none;
}

.crosshair {
  width: 10px;
  height: 10px;
  background-color: rgba(255, 255, 255, 0.75);
}

/* Data-driven visibility starts OFF. `display` is the one property added for
   `if=`, and starting hidden means a slow first frame cannot flash the banner
   before the first value arrives. Unlike .fill above, this IS the value that
   applies until the binding says otherwise — `if=` only ever overwrites it. */
.warning {
  color: #ffcc44;
  align-self: center;
  margin: 10px 0px 0px 0px;
  display: none;
}
