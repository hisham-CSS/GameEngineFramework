<!--
  Sample HUD structure.

  This file IS the sample HUD. Nothing installs it: the default scene has an
  entity carrying a UIDocumentComponent that points here, exactly the way an
  entity carries a mesh or a sound. Select "HUD" in the Hierarchy to see it.

  Structure here, appearance in hud.uss, and VALUES arrive by BINDING: a {hole}
  reads a named property from `scene`, the data source every document in the
  scene shares (seeded in InstallDemoUIContent). Gameplay writes a value; this
  file decides how it reads.

  Because the data source lives OUTSIDE the element tree, a hot reload rebuilds
  every element without losing a single value — so unlike a cached element
  pointer or an event handler, a binding needs nothing re-attached in C++.

  ATTRIBUTES
    name / class / style     as before
    text="SCORE {score}"     literal text with {holes}; write {{ and }} for
                             literal braces
    data-source="scene"      inherited by this element and its whole subtree
    bind="width: {h}"        CSS declarations whose VALUES carry {holes}. Every
                             property .uss understands works here, and a bound
                             property outranks the stylesheet (which then acts
                             as the pre-bind default, and says so at load).
    if="alive"  if="!dead"   visibility from a bool; writes display: flex|none
    on-click="addScore"      calls a NAMED action the app registered
    bind-value="playerName"  TextField only, and the one TWO-WAY binding
    push-hovered="isOver"    element state back to the source (also -pressed,
                             -focused)

  A {hole} is `{path | converter | converter : decimals}`. There is no
  arithmetic and no ternary: derived values are named C++ converters, which are
  breakpointable and unit-testable — and which mean no attribute in this file
  ever needs '<' or '&&', both illegal in an XML attribute value.

  A misspelt ATTRIBUTE is a load error that leaves the running UI untouched. A
  misspelt PATH is reported with the list of properties that do exist, and only
  that one binding goes quiet.

  HOT RELOAD: the running app reads the STAGED copy next to the executable
  (build/bin/<config>/Exported/UI/), which every build refreshes from this file.
  Edit the staged copy to iterate live; copy your changes back here to keep
  them, or edit here and rebuild.
-->
<UI name="hud" data-source="scene">
  <Element name="topBar" class="row">
    <Element name="healthTrack" class="track">
      <!-- One model value, two visual consequences, and no C++ in between.
           `percent` is a builtin (0..1 -> a CSS percentage, unit included);
           `healthTint` is registered by the HUD itself, because a drain ramp
           is a LOOK and belongs next to the markup rather than inside
           gameplay. Switching this bar to fixed pixels is an edit to this
           file. -->
      <Element name="healthFill" class="fill"
               bind="width: {health | percent};
                     background-color: {health | healthTint}"/>
    </Element>
    <!-- The whole readout in one attribute: no placeholder text and no separate
         format string in C++, so there is nothing to drift out of sync. -->
    <!-- `classes` toggles a class from a bool, so the LOOK of "low" lives in
         hud.uss rather than in a colour written from C++. Removing a class
         cannot un-apply its rules on its own — the cascade has no undo — so the
         element is re-cascaded from scratch, exactly as :hover does. -->
    <Label name="scoreLabel" class="readout" classes="alarm: {lowHealth}"
           text="SCORE {score}"/>
  </Element>

  <Element name="buttonRow" class="row-left">
    <!-- A named action, not a statement: `addScore` is a C++ lambda you can
         breakpoint, and a typo is answered with the actions that exist. The
         click still bubbles, so making this a composite widget later changes
         nothing. -->
    <Button name="scoreButton" class="btn" text="+100" on-click="addScore"/>

    <!-- Real text entry. Click it (or Tab to it) and type: the caret places
         itself where you click, arrows and Backspace move by whole characters
         rather than bytes, and `maxlength` is a byte budget that only ever
         truncates on a character boundary.

         A TextField shows its `value`, never a `text` — the value is the one
         source of truth, and the two would otherwise disagree the moment
         anyone typed. -->
    <TextField name="nameField" class="field" bind-value="playerName" maxlength="24"/>
  </Element>

  <!-- The other direction: what you type in the field above lands in the data
       source, and this label reads it straight back out. `bind-value` is
       two-way; `text` is one-way, because you cannot un-format a rendered
       string ("SCORE {score}") back into a value. -->
  <Label name="greeting" class="readout" text="HELLO {playerName | upper}"/>

  <!-- `if` writes display:none rather than removing the element, so it keeps
       its identity, its handlers and its place in this file — and flipping it
       is one style write. `.warning` starts hidden in hud.uss so a slow first
       frame cannot flash the banner. -->
  <Element name="lowHealth" class="warning" if="lowHealth"
           text="LOW HEALTH  {health | ratio : 0}%"/>

  <!-- Decorative overlay. pointer-events:none in the stylesheet, or this
       full-screen layer would swallow every click meant for the UI below. -->
  <Element name="centre" class="centre-overlay">
    <Element name="crosshair" class="crosshair"/>
  </Element>
</UI>
